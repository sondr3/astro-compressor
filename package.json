{
	"name": "@sondr3/astro-compressor",
	"version": "1.3.0",
	"private": true,
	"description": "A gzip, brotli and zstd compressor for Astro",
	"type": "module",
	"scripts": {
		"dev": "pnpm run -r dev",
		"build": "pnpm run --filter 'astro-compressor' -r build",
		"test": "pnpm run -r test",
		"prepare": "lefthook install",
		"check": "oxlint && oxfmt --check",
		"fix": "oxlint --fix && oxfmt"
	},
	"devDependencies": {
		"@sondr3/oxfmt": "0.1.2",
		"@sondr3/oxlint": "0.1.1",
		"lefthook": "2.1.10",
		"oxfmt": "0.58.0",
		"oxlint": "1.73.0",
		"oxlint-tsgolint": "0.24.0"
	},
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@10.33.1"
}
