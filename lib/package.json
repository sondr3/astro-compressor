{
	"name": "astro-compressor",
	"version": "2.0.0-beta.0",
	"private": false,
	"description": "A gzip, brotli and zstd compressor for Astro",
	"keywords": [
		"astro",
		"astro-component",
		"astro-integration",
		"compression",
		"performance"
	],
	"homepage": "https://github.com/sondr3/astro-compressor#readme",
	"bugs": {
		"url": "https://github.com/sondr3/astro-compressor/issues"
	},
	"license": "MIT",
	"author": "Sondre Aasemoen <sondre@eons.io> (https://www.eons.io)",
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/sondr3/astro-compressor.git"
	},
	"files": [
		"dist/",
		"src/",
		"CHANGELOG.md",
		"README.md"
	],
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"imports": {
		"#/*": {
			"types": "./src/*",
			"default": "./dist/*"
		}
	},
	"scripts": {
		"dev": "tsc --watch --incremental -p tsconfig.dev.json",
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"test": "vitest src"
	},
	"devDependencies": {
		"@sondr3/tsconfig": "0.10.0",
		"@types/node": "26.1.1",
		"astro": "catalog:",
		"typescript": "7.0.2",
		"vitest": "4.1.10"
	},
	"engines": {
		"node": ">=24"
	}
}
